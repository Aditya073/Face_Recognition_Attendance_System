<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Profile</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <!-- Header with Logout -->
    <header class="topbar">
      <h2>Student Portal</h2>
      <a href="/logout" class="logout">Logout</a>
    </header>

    <!-- Profile Section -->
    <section class="card profile-card">
      <div class="photo-container">
        <img src="<%= photo || 'data:image/svg+xml;base64,' %>" alt="Student Photo" class="photo">
        <form id="uploadForm" action="/upload-photo" method="post" enctype="multipart/form-data">
          <input type="file" name="photo" id="file-input" accept="image/*" onchange="updatePhoto()">
        </form>
        <label for="file-input" class="upload-btn" title="Change photo" aria-label="Change photo">+</label>
      </div>
      <div class="info">
        <h1 class="name"><%= name %></h1>
        <p class="branch"><%= branch %></p>
      </div>
    </section>

    <!-- Attendance Section -->
    <section class="card">
      <h2 class="section-title">Attendance Record</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Subject</th>
              <th class="num">Attended</th>
              <th class="num">Total Classes</th>
              <th class="num">Attendance Percentage</th>
            </tr>
          </thead>
          <tbody>
            <% if (attendance && attendance.length > 0) { %>
              <% attendance.forEach(sub => { %>
                <tr>
                  <td><%= sub.subject %></td>
                  <td class="num"><%= sub.attendedClasses || 0 %></td>
                  <td class="num"><%= sub.totalClasses || 0 %></td>
                  <td class="num"><span class="percentage"><%= sub.percent || 0 %>%</span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="4" class="empty">No attendance data available</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
  <script src="/js/script.js"></script>
</body>
</html>
