<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teacher Dashboard</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <!-- Sidebar -->
  <nav class="sidebar">
    <h3>Navigation</h3>
    <a href="/teacher" class="active">Dashboard</a>
    <a href="#">Students</a>
    <a href="#">Attendance</a>
    <a href="/logout" class="sidebar-logout">Logout</a>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <h1 class="dashboard-title"><%= name %>'s Dashboard</h1> <!-- Teacher's name at the top -->

    <section class="card profile-card">
      <div class="photo-container">
        <img src="<%= photo || 'data:image/svg+xml;base64,' %>" alt="Teacher Photo" class="photo">
        <form id="uploadForm" action="/upload-teacher-photo" method="post" enctype="multipart/form-data">
          <input type="file" name="photo" id="file-input" accept="image/*" onchange="updatePhoto()">
        </form>
        <label for="file-input" class="upload-btn" title="Change photo" aria-label="Change photo">+</label>
      </div>
      <div class="info">
        <h1 class="name"><%= name %></h1>
        <p class="subject">Subject: <%= subject || 'Not Specified' %></p>
      </div>
    </section>

    <!-- Mark Attendance Section -->
    <section class="card">
      <h2 class="section-title">Mark Attendance</h2>
      <form id="attendanceForm" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="field">
            <label for="subject">Subject</label>
            <select name="subject" id="subject" required>
              <option value="<%= subject || '' %>"><%= subject || 'Select Subject' %></option>
              <option value="Digital Signal Processing">Digital Signal Processing</option>
              <option value="Linear Integrated Circuits">Linear Integrated Circuits</option>
              <option value="Principles of Control System">Principles of Control System</option>
              <option value="Digital Communication">Digital Communication</option>
            </select>
          </div>
          <div class="field">
            <label for="classroomImage">Upload Classroom Photo</label>
            <input type="file" name="classroomImage" id="classroomImage" accept="image/*" required>
            <small class="hint">Upload a photo of the classroom to automatically mark attendance</small>
          </div>
        </div>
        <button type="submit" class="btn">Mark Attendance</button>
      </form>
      <div id="attendanceMessage" class="message" role="status"></div>

      <!-- Export CSV -->
      <div class="export-box">
        <h3 class="section-title">Export Attendance CSV</h3>
        <form action="/export-attendance" method="get">
          <input type="hidden" name="subject" value="<%= subject || '' %>">
          <div class="date-row">
            <div class="field">
              <label for="from">From</label>
              <input type="date" name="from" id="from">
            </div>
            <div class="field">
              <label for="to">To</label>
              <input type="date" name="to" id="to">
            </div>
            <button type="submit" class="btn btn-secondary">Export CSV</button>
          </div>
        </form>
        <details class="details">
          <summary>CSV details</summary>
          <ul>
            <li>One column per lecture session (even if multiple lectures on same day)</li>
            <li>Format: "DD/MM/YYYY" for single lecture, "DD/MM/YYYY (Session N)" for multiple same-day lectures</li>
            <li>Shows 'P' for Present, 'AB' for Absent</li>
            <li>Includes summary row with total attended per session</li>
            <li>Exports all lectures for: <strong><%= subject || 'Selected Subject' %></strong></li>
          </ul>
        </details>
      </div>
    </section>

    <section class="card">
      <h2 class="section-title">Students Attendance Record</h2>
      <div class="table-wrap table-wide">
        <table>
          <thead>
            <tr>
              <th>Student Name</th>
              <th>Branch</th>
              <th class="num">Digital Signal Processing</th>
              <th class="num">Linear Integrated Circuits</th>
              <th class="num">Principles of Control System</th>
              <th class="num">Digital Communication</th>
            </tr>
          </thead>
          <tbody>
            <% if (students && students.length > 0) { %>
              <% students.forEach(std => { %>
                <tr>
                  <td><%= std.name %></td>
                  <td><%= std.branch %></td>
                  <td class="num"><span class="percentage"><%= std['Digital Signal Processing'] %>%</span></td>
                  <td class="num"><span class="percentage"><%= std['Linear Integrated Circuits'] %>%</span></td>
                  <td class="num"><span class="percentage"><%= std['Principles of Control System'] %>%</span></td>
                  <td class="num"><span class="percentage"><%= std['Digital Communication'] %>%</span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="empty">No student data available</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Images Section -->
    <section class="card">
      <h2 class="section-title">Recent Attendance Detection Results (Your Uploads Only)</h2>
      <div class="preview-grid">
        <% if ((recentPreviews || []).length > 0) { %>
          <% recentPreviews.forEach(item => { %>
            <a href="<%= item.url %>" target="_blank" rel="noopener" class="preview-card">
              <img src="<%= item.url %>" alt="Detection Result">
              <div class="preview-caption">
                Date: <%= item.date %><br>
                <strong>Click to view full size</strong>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="empty-state">
            No detection results yet. Upload a classroom photo to see detection results with face boxes and date.
          </div>
        <% } %>
      </div>
      <p class="note">
        <strong>Detection Results:</strong> Preview images show detected faces with bounding boxes (green = recognized, red = unknown), student names, similarity scores, and date watermark. Only your uploaded images' detection results are shown here.
      </p>
    </section>
  </main>

  <script>
    function updatePhoto() {
      document.getElementById('uploadForm').submit();
    }

    // Handle attendance form submission
    document.getElementById('attendanceForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const messageDiv = document.getElementById('attendanceMessage');
      const submitBtn = this.querySelector('button[type="submit"]');
      
      messageDiv.style.display = 'block';
      messageDiv.style.backgroundColor = '#d4edda';
      messageDiv.style.color = '#155724';
      messageDiv.textContent = 'Processing attendance... Please wait.';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Processing...';
      
      try {
        const response = await fetch('/mark-attendance', {
          method: 'POST',
          body: formData
        });
        
        const data = await response.json();
        
        if (data.success) {
          messageDiv.style.backgroundColor = '#d4edda';
          messageDiv.style.color = '#155724';
          messageDiv.innerHTML = `<strong>Success!</strong> ${data.message}<br>Present students: ${data.presentStudents.join(', ') || 'None'}`;
          // Reload page after 2 seconds to show updated attendance
          setTimeout(() => {
            window.location.reload();
          }, 2000);
        } else {
          messageDiv.style.backgroundColor = '#f8d7da';
          messageDiv.style.color = '#721c24';
          messageDiv.innerHTML = `<strong>Error:</strong> ${data.message}`;
          submitBtn.disabled = false;
          submitBtn.textContent = 'Mark Attendance';
        }
      } catch (error) {
        messageDiv.style.backgroundColor = '#f8d7da';
        messageDiv.style.color = '#721c24';
        messageDiv.innerHTML = `<strong>Error:</strong> ${error.message}`;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Mark Attendance';
      }
    });
  </script>
</body>
</html>
